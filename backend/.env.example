# PatientPlex AI Backend Environment Variables
# Copy to .env and fill in your values

# ========== DATABASE ==========
DATABASE_URL=postgresql+asyncpg://cliniccare:cliniccare@localhost:5432/cliniccare

# ========== SECURITY ==========
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== GOOGLE ==========
# Google OAuth (Calendar integration)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/onboarding/google-calendar/callback

# Google Ads API (apply at https://developers.google.com/google-ads/api/docs/get-started/dev-token)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ========== META ==========
# Meta App (ads_management permission required)
# Create at https://developers.facebook.com/apps/
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# META_AD_ACCOUNT_ID=act_123456789
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# ========== WHATSAPP ==========
# WhatsApp Business API (via Meta Cloud API or Twilio)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=your-whatsapp-api-token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ========== LINKEDIN ==========
# LinkedIn Marketing API (apply at https://www.linkedin.com/developers/)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AD_ACCOUNT_ID=

# ========== AI ==========
# Claude API (for AI receptionist + ad copy generation)
# Get at https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key
