# PatientPlex AI Backend Environment Variables
# Copy to .env and fill in your values

# ========== DATABASE ==========
# PRODUCTION: Use a strong, unique password — never use defaults in production
DATABASE_URL=postgresql+asyncpg://cliniccare:cliniccare@localhost:5432/cliniccare
POSTGRES_PASSWORD=cliniccare

# ========== SECURITY ==========
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Field-level encryption key for OAuth tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PRODUCTION: Required — tokens are stored unencrypted without it
ENCRYPTION_KEY=

# ========== GOOGLE ==========
# Google OAuth (Calendar integration)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/onboarding/google-calendar/callback

# Google Ads API (apply at https://developers.google.com/google-ads/api/docs/get-started/dev-token)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ========== META ==========
# Meta App (ads_management permission required)
# Create at https://developers.facebook.com/apps/
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# META_AD_ACCOUNT_ID=act_123456789
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# ========== WHATSAPP ==========
# WhatsApp Business API (via Meta Cloud API or Twilio)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=your-whatsapp-api-token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ========== LINKEDIN ==========
# LinkedIn Marketing API (apply at https://www.linkedin.com/developers/)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AD_ACCOUNT_ID=

# ========== AI ==========
# Claude API (for AI receptionist + ad copy generation)
# Get at https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key

# ========== REDIS ==========
# Caching + rate limiting
REDIS_URL=redis://localhost:6379/0

# ========== TELEPHONY ==========
# Choose provider: "twilio" or "exotel"
CALL_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+14155238886

# Exotel (India-specific alternative)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_CALLER_ID=

# ========== SCHEDULING ==========
# Cal.com (open-source appointment booking)
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com/v1
CALCOM_EVENT_TYPE_ID=0

# ========== PAYMENTS ==========
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=

# ========== GOOGLE MY BUSINESS ==========
# Google Business Profile API
# Create at https://console.cloud.google.com/apis/credentials
# GOOGLE_GMB_API_KEY=

# ========== CHATGPT ADS ==========
# OpenAI Sponsored Answers (ChatGPT Ads)
# CHATGPT_ADS_API_KEY=

# ========== GOOGLE ANALYTICS 4 ==========
# GA4 Measurement Protocol (server-side event tracking)
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your-measurement-protocol-secret
# GA4_PROPERTY_ID=123456789

# ========== CLINIC DEFAULTS ==========
CLINIC_DEFAULT_OPEN_TIME=09:00
CLINIC_DEFAULT_CLOSE_TIME=20:00
SLOT_DURATION_MINUTES=30
MISSED_CALL_WHATSAPP_DELAY_SECONDS=30
